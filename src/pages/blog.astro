---
import Layout from '../layouts/Layout.astro';
import type { BlogArticle } from '../types/blog';

const response = await fetch('https://dev.to/api/articles/latest?username=sameer1612');
const blogs: BlogArticle[] = await response.json();
---

<Layout>
  <main class="bg-alpha grid h-screen place-items-center">
    <h2 class="text-gamma mb-8 text-center text-3xl font-bold">Blog</h2>
    <div class="safe-width grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        blogs.map(blog => (
          <a
            href={blog.canonical_url}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:border-gamma block overflow-hidden rounded-lg border-2 border-transparent bg-white transition-all duration-300 hover:border-2"
          >
            {blog.cover_image && (
              <img src={blog.cover_image} alt={blog.title} class="w-full object-cover" loading="lazy" />
            )}
            <div class="mt-2 flex flex-col gap-3 p-6">
              <h6 class="text-gamma text-xl font-semibold">{blog.title}</h6>
              <p class="text-delta line-clamp-3 text-sm">{blog.description}</p>
              <div class="text-gamma mt-auto flex items-center justify-between text-sm">
                <span>{blog.readable_publish_date}</span>
                <span>{blog.reading_time_minutes} min read</span>
              </div>
              <div class="flex flex-wrap gap-2">
                {blog.tag_list.map(tag => (
                  <span class="bg-beta text-gamma rounded px-2 py-0.5 text-xs">#{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
