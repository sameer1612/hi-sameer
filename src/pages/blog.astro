---
import Layout from '../layouts/Layout.astro';
import type { BlogArticle } from '../types/blog';

const response = await fetch('https://dev.to/api/articles/latest?username=sameer1612');
const blogs: BlogArticle[] = await response.json();
---

<Layout>
  <main class="bg-alpha safe-width mt-16">
    <section aria-label="Latest blog posts" class="grid gap-3 lg:mt-auto lg:grid-cols-2">
      {
        blogs.map(blog => (
          <article class="bg-beta hover:bg-beta/70 overflow-hidden rounded-lg p-3 transition-all duration-200 hover:scale-[99.75%]">
            <a
              href={blog.canonical_url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-full min-h-36 flex-col gap-4 lg:flex-row"
            >
              {blog.cover_image && (
                <img src={blog.cover_image} alt={blog.title} class="rounded-lg object-cover lg:w-1/3" loading="lazy" />
              )}
              <div class="flex flex-col justify-between">
                <header>
                  <h2 class="text-delta text-lg! font-medium">{blog.title}</h2>
                </header>
                <p class="text-gamma mt-2 text-sm">{blog.description}</p>
              </div>
            </a>
          </article>
        ))
      }
    </section>
  </main>
</Layout>
