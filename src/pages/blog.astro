---
import Layout from '../layouts/Layout.astro';
import type { BlogArticle } from '../types/blog';

const response = await fetch('https://dev.to/api/articles/latest?username=sameer1612');
const blogs: BlogArticle[] = await response.json();
---

<Layout>
  <main class="bg-alpha safe-width mt-16">
    <section aria-label="Latest blog posts" class="grid gap-3 md:grid-cols-2 lg:mt-auto lg:grid-cols-3">
      {
        blogs.map(blog => (
          <article class="bg-beta hover:bg-beta/70 rounded-lg p-2 transition-all duration-200 hover:scale-[99.75%]">
            <a href={blog.canonical_url} target="_blank" rel="noopener noreferrer" class="flex items-start gap-2">
              {blog.cover_image && (
                <img
                  src={blog.cover_image}
                  alt={blog.title}
                  class="size-28 shrink-0 rounded-lg object-cover"
                  loading="lazy"
                />
              )}
              <div class="flex flex-col gap-2">
                <h2 class="text-delta font-roboto text-base! leading-snug font-medium">{blog.title}</h2>
                <p class="text-gamma line-clamp-2 text-sm">{blog.description}</p>
              </div>
            </a>
          </article>
        ))
      }
    </section>
  </main>
</Layout>
