---
import Layout from '../layouts/Layout.astro';
import { blogs } from '../data/blogs';

const byYear = Map.groupBy(blogs, blog => new Date(blog.date).getUTCFullYear());
const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const host = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<Layout title="Blog">
  <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Blog</h1>
  <p class="prose text-gamma mt-6">
    Notes on frontend, architecture, developer tools and the craft of engineering. Posts open on the site where they were first
    published.
  </p>

  {
    [...byYear].map(([year, posts]) => (
      <section aria-labelledby={`year-${year}`} class="mt-16">
        <h2 id={`year-${year}`} class="eyebrow">
          {year}
        </h2>
        <ul class="mt-6 space-y-8">
          {posts.map(blog => (
            <li>
              <a
                href={blog.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-start justify-between gap-8"
              >
                <div class="min-w-0">
                  <h3 class="decoration-accent/50 group-hover:decoration-accent-hover text-xl leading-snug font-semibold underline-offset-4 group-hover:underline">
                    {blog.title}
                  </h3>
                  <p class="text-gamma mt-1.5 max-w-[75ch] leading-relaxed">{blog.summary}</p>
                  <p class="text-gamma mt-2 font-sans text-[0.8125rem]">
                    <time datetime={blog.date}>{formatDate(blog.date)}</time>
                    <span aria-hidden="true"> · </span>
                    {blog.readingTime} min read
                    <span aria-hidden="true"> · </span>
                    {host(blog.url)} <span aria-hidden="true">↗</span>
                    <span class="sr-only">(opens in new tab)</span>
                  </p>
                </div>
                {blog.cover && (
                  <img
                    src={blog.cover}
                    alt=""
                    loading="lazy"
                    class="bg-beta hidden aspect-[100/42] w-40 shrink-0 rounded-md object-cover opacity-90 transition-opacity group-hover:opacity-100 sm:block"
                  />
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>
