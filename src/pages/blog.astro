---
import Layout from '../layouts/Layout.astro';
import type { BlogArticle } from '../types/blog';

const response = await fetch('https://dev.to/api/articles/latest?username=sameer1612');
const blogs: BlogArticle[] = await response.json();
---

<Layout>
  <main class="bg-alpha grid h-screen place-items-center">
    <h2 class="text-gamma mb-8 text-center text-3xl font-bold">Blog</h2>
    <div class="safe-width grid auto-rows-fr gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        blogs.map(blog => (
          <a
            href={blog.canonical_url}
            target="_blank"
            rel="noopener noreferrer"
            class="relative overflow-hidden rounded-lg shadow"
          >
            {blog.cover_image && (
              <img
                src={blog.cover_image}
                alt={blog.title}
                class="aspect-[2/1] w-full object-cover object-top"
                loading="lazy"
              />
            )}
            <div class="absolute inset-x-0 bottom-0 flex h-1/2 items-end bg-gradient-to-t from-black to-transparent p-4">
              <p class="text-white">{blog.title}</p>
            </div>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
