---
import Layout from '../layouts/Layout.astro';
---

<Layout
  center
  description="Sameer Kumar, Senior Lead of Engineering at Zensar Technologies. Building scalable products, modernizing messy systems and writing about software engineering."
>
  <section>
    <p class="text-gamma text-[3.5rem] leading-[1.02] font-medium tracking-tight sm:text-7xl md:text-8xl">
      Quietly
      <br />
      engineering.
    </p>

    <div class="mt-12 flex items-center gap-4 md:mt-16">
      <div class="bg-beta size-16 shrink-0 overflow-hidden rounded-full in-data-[theme=light]:bg-accent/40">
        <img src="/images/sameer-bw.webp" alt="Portrait of Sameer Kumar" class="size-full object-cover" />
      </div>
      <div class="font-sans">
        <h1 class="text-delta font-medium pb-0.5">Sameer Kumar</h1>
        <p class="text-delta text-sm flex flex-col">
          <span>Senior Lead of Engineering</span>
          <a
            href="https://www.zensar.com"
            target="_blank"
            rel="noopener noreferrer"
            class="link no-underline hover:text-delta transition-colors"
          >
            Zensar Technologies
          </a>
        </p>
      </div>
    </div>

    <p class="text-delta mt-8 max-w-[56ch] text-[1.0625rem] leading-relaxed">
      Engineer by title, systems builder by instinct. I enjoy building scalable products, modernizing messy systems, and
      turning complicated workflows into clean, maintainable solutions.
    </p>

    <ul class="mt-8 flex flex-wrap gap-x-8 gap-y-3 font-sans text-[0.9375rem]">
      <li>
        <a href="/about" class="link">
          More about me →
        </a>
      </li>
      <li>
        <a href="/blog" class="link">
          Read the blog →
        </a>
      </li>
    </ul>
  </section>
</Layout>
