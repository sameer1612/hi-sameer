---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="safe-width !main-height flex flex-col items-start justify-center gap-8 md:!h-screen md:justify-center">
    <div class="flex flex-col items-start">
      <h1 class="font-bold">SAMEER</h1>
      <h6 class="text-gamma">Not yet another engineer!</h6>
    </div>

    <a href="/about" class="z-10">
      <button class="btn-primary">
        About me
        <span class="pi pi-arrow-right text-xs"></span>
      </button>
    </a>

    <img src="/images/sameer-light.webp" alt="Sameer Kumar" class="fixed -right-1/7 bottom-0 max-h-1/2 md:right-0" />
  </main>
</Layout>
