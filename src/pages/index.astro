---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="mx-auto flex h-[90vh] flex-col items-center justify-center bg-green-50">
    <div class="relative flex flex-col items-center justify-center gap-1 p-4">
      <h1 class="text-6xl">I am Sameer</h1>
      <h3 class="text-2xl">Not yet another engineer !</h3>
      <img class="shuriken absolute -right-4 -top-4 lg:-right-8 size-12" src="/images/ninja.png" alt="shuriken" />
    </div>
    <p class="font-kalam mt-8 w-[90%] text-center text-xl lg:mt-16 lg:w-[50%]">
      Meet Sameer, the groovy web ninja who transforms ideas into pixel-perfect realities, leaving a trail of
      awe-inspiring web experiences!
    </p>
  </div>
</Layout>
