---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="mx-auto flex h-full flex-col items-center justify-center gap-4">
    <div class="flex flex-col items-center p-4">
      <h1 class="text-title green">I am Sameer</h1>
      <h3 class="text-subtitle green">Not yet another engineer!</h3>
    </div>
    <p class="text-lg w-4/5 text-center md:w-1/2 green">
      Meet Sameer, the groovy web ninja who transforms ideas into pixel-perfect realities, leaving a trail of
      awe-inspiring web experiences!
    </p>
  </main>
</Layout>
