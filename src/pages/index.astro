---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="flex flex-col items-start gap-8 md:justify-center">
    <div class="mt-[20vh] flex flex-col items-start md:mt-0">
      <h1>SAMEER KUMAR</h1>
      <h6 class="text-gamma dark:hidden">Senior Technical Consultant</h6>
      <h6 class="text-gamma hidden dark:block">Not yet another engineer!</h6>
    </div>

    <a href="/about" class="z-10">
      <button class="btn-primary">
        About me
        <span class="pi pi-arrow-right text-xs"></span>
      </button>
    </a>

    <picture>
      <source srcset="/images/sameer-dark.webp" media="(prefers-color-scheme: dark)" />
      <img src="/images/sameer-light.webp" alt="Sameer Kumar" class="fixed -right-1/7 bottom-0 max-h-1/2 md:right-0" />
    </picture>
  </main>
</Layout>
