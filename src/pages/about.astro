---
import AboutText from '../components/AboutText.astro';
import Journey from '../components/Journey.astro';
import Testimonials from '../components/testimonials.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main>
    <div class="pointer-events-none relative hidden h-1/2 md:fixed md:right-0 md:bottom-0 md:block">
      <img src="/images/sameer.png" alt="Sameer Kumar" class="h-full w-auto grayscale-35" />
      <div class="from-alpha absolute inset-0 bg-linear-to-r via-transparent to-transparent"></div>
    </div>

    <div class="safe-width bg-alpha mt-12 flex min-h-full flex-col justify-center gap-8 md:mt-auto md:w-3/5">
      <AboutText />
      <img
        src="/scroll-down.svg"
        alt="scroll down"
        class="fixed right-8 bottom-1/4 -z-10 size-8 md:right-auto md:bottom-4"
      />
    </div>

    <div class="safe-width bg-alpha flex min-h-full flex-col justify-center gap-8 md:w-3/5">
      <Journey />
    </div>

    <div class="safe-width bg-alpha flex min-h-full flex-col justify-center gap-8 md:w-3/5">
      <Testimonials />
    </div>
  </main>
</Layout>
