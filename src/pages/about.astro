---
import AboutText from '../components/AboutText.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main>
    <div class="relative h-full md:hidden">
      <img src="/images/about.webp" alt="Sameer Kumar" class="fading-image absolute bottom-0 -ml-10 scale-x-[-1]" />
    </div>

    <img
      src="/images/about.webp"
      alt="Sameer Kumar"
      class="hidden md:fixed md:right-0 md:bottom-0 md:block md:w-auto"
    />

    <div class="safe-width flex h-full flex-col justify-center gap-8">
      <AboutText />
    </div>
  </main>
</Layout>
