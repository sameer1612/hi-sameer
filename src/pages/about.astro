---
import Testimonial from '../components/Testimonial.astro';
import Layout from '../layouts/Layout.astro';
import { journeyList } from '../data/journey';
import { testimonials } from '../data/testimonials';

const featured = testimonials.filter(t => t.featured);
const others = testimonials.filter(t => !t.featured);
const paragraphs = (text: string) =>
  text
    .split('\n')
    .map(line => line.trim())
    .filter(Boolean);
---

<Layout title="About">
  <article>
    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">About</h1>

    <div class="prose mt-10">
      <p>
        Hey, I'm Sameer — engineer by title, systems builder by instinct. I enjoy building scalable products,
        modernizing messy systems, and turning complicated workflows into clean, maintainable solutions.
      </p>
      <p>
        Most of my work revolves around architecture, performance, platform design, and solving problems that sit
        somewhere between engineering and product thinking. I like understanding how things work under the hood,
        simplifying complexity, and occasionally experimenting with ideas that probably shouldn’t work as well as they
        do.
      </p>
      <p>
        Outside work, I spend time exploring tech rabbit holes, teaching, tinkering with new ideas, and over-optimizing
        things that were already fast enough.
      </p>
    </div>

    <hr class="border-gamma/30 mt-20" />

    <section aria-labelledby="experience" class="mt-20">
      <h2 id="experience" class="eyebrow">Experience</h2>

      <ol class="mt-8 space-y-12">
        {
          journeyList.map(company => (
            <li>
              <h3 class="text-2xl font-semibold tracking-tight">{company.title}</h3>
              <ol class="mt-5 space-y-8">
                {company.roles.map(role => (
                  <li>
                    <p class="text-gamma font-sans text-[0.9375rem] font-medium">{role.position}</p>
                    <div class="prose mt-2">
                      {paragraphs(role.description).map(line => (
                        <p>{line}</p>
                      ))}
                    </div>
                  </li>
                ))}
              </ol>
            </li>
          ))
        }
      </ol>
    </section>

    <hr class="border-gamma/30 mt-20" />

    <section aria-labelledby="kind-words" class="mt-20">
      <h2 id="kind-words" class="eyebrow">Kind words</h2>

      <div class="mt-8 space-y-10">
        {featured.map(t => <Testimonial testimonial={t} featured />)}
      </div>

      <details class="group mt-10">
        <summary
          class="text-accent hover:text-accent-hover w-fit cursor-pointer font-sans text-[0.9375rem] font-medium transition-colors"
        >
          <span class="group-open:hidden">Show {others.length} more</span>
          <span class="hidden group-open:inline">Show fewer</span>
        </summary>

        <div class="mt-10 space-y-10">
          {others.map(t => <Testimonial testimonial={t} />)}
        </div>
      </details>
    </section>
  </article>
</Layout>
