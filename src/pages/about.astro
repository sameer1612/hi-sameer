---
import AboutText from '../components/AboutText.astro';
import Journey from '../components/Journey.astro';
import Testimonials from '../components/testimonials.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main>
    <div class="relative h-9/10 md:hidden">
      <img
        src="/images/about.webp"
        alt="Sameer Kumar"
        class="fading-image absolute bottom-0 left-0 h-3/4 scale-x-[-1]"
      />
    </div>

    <img
      src="/images/about.webp"
      alt="Sameer Kumar"
      class="hidden h-3/4 md:fixed md:right-0 md:bottom-0 md:block md:w-auto"
    />

    <div class="safe-width bg-alpha flex h-full flex-col justify-center gap-8 md:w-3/5">
      <AboutText />
      <img
        src="/scroll-down.svg"
        alt="scroll down"
        class="fixed right-8 bottom-1/4 -z-10 size-8 md:right-auto md:bottom-4"
      />
    </div>

    <div class="safe-width bg-alpha flex h-full flex-col justify-center gap-8 md:w-3/5">
      <Journey />
    </div>

    <div class="safe-width bg-alpha flex h-full flex-col justify-center gap-8 md:w-3/5">
      <Testimonials />
    </div>
  </main>
</Layout>
