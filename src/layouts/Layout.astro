---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  /** Vertically center short pages between header and footer. */
  center?: boolean;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  /** Publication date, for articles. */
  published?: Date;
}

const { title, center = false, description, canonical, image, type, published } = Astro.props;
const fullTitle = title ? `${title} · Sameer Kumar` : 'Sameer Kumar';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/images/ninja.png" type="image/png" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <script is:inline>
      const query = matchMedia('(prefers-color-scheme: light)');
      const browserTheme = () => (query.matches ? 'light' : 'dark');
      // A manual toggle is kept in sessionStorage for 5 minutes, then the browser setting wins again.
      const override = () => {
        try {
          const { theme, expires } = JSON.parse(sessionStorage.getItem('theme-override'));
          if (Date.now() < expires) return theme;
          sessionStorage.removeItem('theme-override');
        } catch {}
      };
      document.documentElement.dataset.theme = override() ?? browserTheme();
      query.addEventListener('change', () => {
        try {
          sessionStorage.removeItem('theme-override');
        } catch {}
        document.documentElement.dataset.theme = browserTheme();
      });
    </script>
    <Seo
      title={fullTitle}
      headline={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      published={published}
    />
  </head>
  <body class="mx-auto flex min-h-dvh w-full flex-col px-5 md:w-[80vw] md:px-0">
    <Header />
    <main class:list={['grow py-12 md:py-20', center && 'flex flex-col justify-center']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
