---
interface Props {
  title: string;
  description?: string;
  /** Absolute canonical URL; defaults to this page on the site. */
  canonical?: string;
  /** Image path or absolute URL for link previews. */
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Senior Lead of Engineering at Zensar Technologies. Writing about software architecture, frontend and engineering practice.',
  // Without a trailing slash, matching the site's links (Firebase serves both forms).
  canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site).href,
  image = '/images/sameer.png',
  type = 'website',
} = Astro.props;

const imageUrl = new URL(image, Astro.site).href;
---

<!-- SEO Meta Tags -->
<meta name="description" content={description} />
<meta
  name="keywords"
  content="Sameer Kumar, developer, portfolio, projects, blogs, software engineer, technical consultant, web development, system architecture, programming, technology, innovation"
/>
<meta name="author" content="Sameer Kumar" />
<meta name="robots" content="index, follow" />

<!-- Open Graph Meta Tags -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content="en_US" />

<!-- Twitter Card Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<link rel="canonical" href={canonical} />

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Sameer Kumar",
    "url": "https://hi-sameer.web.app",
    "image": "https://hi-sameer.web.app/images/sameer.png",
    "jobTitle": "Senior Lead of Engineering",
    "worksFor": {
      "@type": "Organization",
      "name": "Zensar Technologies"
    },
    "description": "Senior Lead of Engineering at Zensar Technologies. Writing about software architecture, frontend and engineering practice.",
    "sameAs": [
      "https://www.linkedin.com/in/sameerkumar1612/",
      "https://github.com/sameer1612",
      "https://medium.com/@sameer-kumar-1612",
      "https://hi-sameer.vercel.app"
    ],
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "Silicon Institute of Technology, Bhubaneswar"
    },
    "knowsAbout": [
      "Software Engineering",
      "Technical Consulting",
      "Web Development",
      "System Architecture",
      "Project Management"
    ],
    "nationality": "Indian"
  }
</script>
