---
interface Props {
  title: string;
  description?: string;
  /** Absolute canonical URL; defaults to this page on the site. */
  canonical?: string;
  /** Image path or absolute URL for link previews; defaults to the portrait. */
  image?: string;
  /** Alt text for the preview image. */
  imageAlt?: string;
  type?: 'website' | 'article';
  /** Post headline without the site suffix; used for article structured data. */
  headline?: string;
  /** Publication date of an article. */
  published?: Date;
  /** Article topics, emitted as structured-data keywords. */
  tags?: string[];
}

const {
  title,
  description = 'Senior Lead of Engineering at Zensar Technologies. Writing about software architecture, frontend and engineering practice.',
  // Without a trailing slash, matching the site's links (Firebase redirects the slashed form).
  canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site).href,
  image,
  type = 'website',
  headline = title,
  imageAlt = image ? headline : 'Portrait of Sameer Kumar',
  published,
  tags = [],
} = Astro.props;

const imageUrl = new URL(image ?? '/images/sameer.webp', Astro.site).href;
// A wide preview suits a post cover; the square portrait would be cropped, so it gets the small card.
const twitterCard = image ? 'summary_large_image' : 'summary';

const person = {
  '@type': 'Person',
  name: 'Sameer Kumar',
  url: 'https://hi-sameer.web.app',
  image: 'https://hi-sameer.web.app/images/sameer.webp',
  jobTitle: 'Senior Lead of Engineering',
  worksFor: {
    '@type': 'Organization',
    name: 'Zensar Technologies',
  },
  description:
    'Senior Lead of Engineering at Zensar Technologies. Writing about software architecture, frontend and engineering practice.',
  sameAs: [
    'https://www.linkedin.com/in/sameerkumar1612/',
    'https://github.com/sameer1612',
    'https://medium.com/@sameer-kumar-1612',
  ],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Silicon Institute of Technology, Bhubaneswar',
  },
  knowsAbout: [
    'Software Engineering',
    'Technical Consulting',
    'Web Development',
    'System Architecture',
    'Project Management',
  ],
  nationality: 'Indian',
};

const structuredData =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline,
        description,
        image: imageUrl,
        url: canonical,
        mainEntityOfPage: canonical,
        datePublished: published?.toISOString(),
        keywords: tags.length ? tags.join(', ') : undefined,
        author: person,
      }
    : { '@context': 'https://schema.org', ...person };
---

<!-- SEO Meta Tags -->
<meta name="description" content={description} />
<meta name="author" content="Sameer Kumar" />
<meta name="robots" content="index, follow" />
<!-- Search Console ownership; public/google762149d9329a54ed.html is the file-based fallback. -->
<meta name="google-site-verification" content="ZfeSkGVZznicB4bWGUutG_Ih29zzos-rAcLN2fGxAKE" />

<!-- Open Graph Meta Tags -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content="Sameer Kumar" />
<meta property="og:locale" content="en_US" />
{published && <meta property="article:published_time" content={published.toISOString()} />}

<!-- Twitter Card Meta Tags -->
<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap.xml" />

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
