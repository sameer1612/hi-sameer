---
const currentRoute = Astro.url.pathname;

const routes = {
  '/': 'Home',
  '/about': 'About',
  '/tech': 'Tech',
  '/blog': 'Blog',
};
---

<nav class=`flex justify-center gap-1 mt-4`>
  {
    Object.entries(routes).map(([path, name]) => (
      <a
        href={path}
        class={`rounded-full px-4 py-1 text-center text-green-950 bg-green-100 ${currentRoute === path ? 'font-medium' : ''}`}
      >
        {name}
      </a>
    ))
  }
</nav>
