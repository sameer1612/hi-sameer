---
const routes = [
  { path: '/about', name: 'About' },
  { path: '/blog', name: 'Blog' },
  { path: '/contact', name: 'Contact' },
  { path: '/resume.pdf', name: 'Resume' },
];

const current = Astro.url.pathname.replace(/\/$/, '');
---

<header class="flex items-baseline justify-between gap-6 pt-8 font-sans text-[0.9375rem]">
  <!-- Hidden on Home, where the byline already shows the name; kept in layout so the nav stays right-aligned. -->
  <a
    href="/"
    class:list={[
      'text-delta hover:text-accent-hover font-semibold tracking-tight transition-colors',
      current === '' && 'invisible',
    ]}
  >
    Sameer<span class="max-sm:hidden"> Kumar</span>
  </a>

  <nav aria-label="Main">
    <ul class="flex gap-4 sm:gap-6">
      {
        routes.map(({ path, name }) => {
          const active = current === path;
          return (
            <li>
              <a
                href={path}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  '-my-3 inline-block py-3 transition-colors',
                  active
                    ? 'text-delta decoration-accent underline decoration-2 underline-offset-8'
                    : 'text-gamma hover:text-delta',
                ]}
              >
                {name}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
