---
import { rotateLeft } from '../utils/arrays';

let routes = [
  ['/', 'home'],
  ['/about', 'about'],
  ['/blog', 'blog'],
  ['/contact', 'contact'],
  ['/resume.pdf', 'resume'],
];

const currentRouteIndex = routes.findIndex(
  ([path]) => path.replaceAll('/', '') === Astro.url.pathname.replaceAll('/', ''),
);
routes = rotateLeft(routes, currentRouteIndex);
---

<header class="bg-alpha safe-width fixed top-0 z-10 mx-auto flex w-screen items-center justify-between py-4">
  <h4 class="text-accent capitalize">{routes[0][1]}</h4>

  <nav class="flex items-center gap-4">
    {
      routes.slice(1).map(([path, name]) => (
        <a
          href={path}
          target={path === '/resume.pdf' ? '_blank' : '_self'}
          class="text-gamma hover:text-accent-hover font-montserrat text-sm font-medium uppercase underline-offset-4 transition-colors hover:underline md:text-base"
        >
          {name}
        </a>
      ))
    }
    <button
      id="theme-toggle"
      type="button"
      role="switch"
      aria-label="Light mode"
      class="border-gamma hover:border-accent-hover relative h-6 w-11 shrink-0 cursor-pointer rounded-full border transition-colors"
    >
      <span
        class="bg-gamma text-alpha absolute top-px left-px flex size-5 items-center justify-center rounded-full transition-transform in-data-[theme=light]:translate-x-5"
      >
        <span class="flex in-data-[theme=light]:hidden"><i class="pi pi-moon text-[0.65rem]!"></i></span>
        <span class="hidden in-data-[theme=light]:flex"><i class="pi pi-sun text-[0.65rem]!"></i></span>
      </span>
    </button>
  </nav>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggle = document.getElementById('theme-toggle');
    if (!toggle) return;
    const sync = () => toggle.setAttribute('aria-checked', String(document.documentElement.dataset.theme === 'light'));
    sync();
    toggle.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      sync();
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });
  });
</script>
