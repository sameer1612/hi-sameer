---
import { rotateLeft } from '../utils/arrays';

let routes = [
  ['/', 'home'],
  ['/about', 'about'],
  ['/blog', 'blog'],
  ['/contact', 'contact'],
  ['/resume.pdf', 'resume'],
];

const currentRouteIndex = routes.findIndex(
  ([path]) => path.replaceAll('/', '') === Astro.url.pathname.replaceAll('/', ''),
);
routes = rotateLeft(routes, currentRouteIndex);
---

<header class="bg-alpha safe-width fixed top-0 z-10 mx-auto flex w-screen items-center justify-between py-4">
  <h4 class="text-accent capitalize">{routes[0][1]}</h4>

  <nav class="flex items-center gap-4">
    {
      routes.slice(1).map(([path, name]) => (
        <a
          href={path}
          target={path === '/resume.pdf' ? '_blank' : '_self'}
          class="text-gamma hover:text-accent-hover font-montserrat text-sm font-medium uppercase underline-offset-4 transition-colors hover:underline md:text-base"
        >
          {name}
        </a>
      ))
    }
    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle light/dark mode"
      class="text-gamma hover:text-accent-hover cursor-pointer transition-colors"
    >
      <i class="pi pi-sun theme-dark-only"></i>
      <i class="pi pi-moon theme-light-only"></i>
    </button>
  </nav>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });
  });
</script>

<style>
  :global([data-theme='light']) .theme-dark-only,
  :global(:root:not([data-theme='light'])) .theme-light-only {
    display: none;
  }
</style>
